{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elma-iot.github.io/elma-iot-docs/schema/custom-hardware-documentation.schema.json",
  "title": "ELMA-IoT custom hardware documentation bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["hardwareId", "helpId", "documentation"],
  "properties": {
    "hardwareId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "helpId": {"type": "string", "pattern": "^custom\\.[a-z0-9][a-z0-9._-]+$"},
    "documentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description"],
      "properties": {
        "title": {"type": "string", "maxLength": 160},
        "description": {"type": "string", "maxLength": 10000},
        "pins": {"type": "array", "items": {"type": "object"}},
        "configuration": {"type": "array", "items": {"type": "object"}},
        "logicCapabilities": {"type": "array", "items": {"type": "object"}},
        "libraries": {"type": "array", "items": {"type": "string", "maxLength": 300}},
        "limitations": {"type": "array", "items": {"type": "string", "maxLength": 1000}},
        "images": {"type": "array", "items": {"type": "string", "pattern": "^[a-zA-Z0-9_./-]+\\.(png|jpg|jpeg|webp|svg)$"}},
        "examples": {"type": "array", "items": {"type": "object"}},
        "translations": {"type": "object", "additionalProperties": {"type": "object"}}
      }
    }
  }
}
